# Shorts Studio server configuration (API + workers). Copy to .env and fill in.
# Secrets live ONLY here (server env vars). Never commit .env.

# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave empty to verify with JWKS.
SUPABASE_JWT_SECRET=
# Direct or session-pooler connection string (Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Redis (queue) ---
REDIS_URL=redis://redis:6379/0

# --- Cloudflare R2 (S3 API) ---
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=shorts-studio

# --- App ---
# Encrypts secrets saved in Settings (Gemini key, proxy, cookies). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes saved secrets unreadable (re-enter them).
APP_ENCRYPTION_KEY=
# The owner/founder account: full control, the only one who can add/remove admins.
# Takes effect once this email has signed up AND verified its address.
OWNER_EMAIL=you@example.com
# Web app origin(s), comma-separated. The first one is used in invite links.
WEB_ORIGINS=https://studio.example.com
# AI provider keys. All optional: the owner can also add keys in Admin → AI & storage settings → AI providers,
# where they're stored encrypted. A key set here wins and shows as "set via environment".
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
JOBS_PER_USER_PER_MINUTE=10

# --- Workers ---
WORKER_MEDIA_CONCURRENCY=2
WORKER_AI_CONCURRENCY=8
IMAGE_CONCURRENCY=4
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
API_DOMAIN=api.studio.example.com

# --- Local development values (local Supabase CLI + S3 emulator from infra/compose.yml) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<"SERVICE_ROLE_KEY" printed by `make supabase-start`>
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# REDIS_URL=redis://127.0.0.1:6379/0
# S3_ENDPOINT=http://127.0.0.1:9090
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=dev
# S3_SECRET_ACCESS_KEY=dev
# WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
